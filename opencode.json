{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["alibaba", "alibaba-cn"],
  "disabled_providers": ["deepseek", "deepinfra", "google", "opencode"],
  "instructions": ["config/opencode-instructions-convmem.example.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "task": "allow",
    "skill": "allow",
    "edit": {
      "*": "deny",
      ".opencode/scratch/*": "allow"
    },
    "bash": {
      "*": "ask",
      "convmem *": "allow",
      "convmem": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      "git show*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "python -c *": "allow",
      "python --version*": "allow",
      "pip list*": "allow",
      "pip show*": "allow",
      "pytest *": "allow",
      "ruff check*": "allow",
      "pylint *": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "* --no-verify": "deny",
      "chmod 777*": "deny",
      "mkfs*": "deny",
      "dd * of=/dev/*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "convmem record*": "deny",
      "convmem index*": "deny",
      "git push*": "ask",
      "git commit*": "ask",
      "git add*": "ask",
      "npm publish*": "deny",
      "docker push*": "deny"
    },
    "external_directory": {
      "~/Projects/*": "allow",
      "~/.config/crush/*": "allow",
      "~/.local/share/convmem/*": "allow"
    }
  }
}
