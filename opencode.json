{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "alibaba",
    "alibaba-cn",
    "ollama"
  ],
  "disabled_providers": [
    "deepseek",
    "deepinfra",
    "google",
    "opencode"
  ],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder-30b-opencode": {
          "name": "qwen3-coder-30b-opencode"
        },
        "qwen3-coder:30b": {
          "name": "qwen3-coder:30b"
        },
        "qwen3.8:latest": {
          "name": "qwen3.8:latest"
        }
      }
    }
  },
  "instructions": [
    "config/opencode-instructions-convmem.example.md"
  ],
  "mcp": {
    "convmem": {
      "type": "local",
      "command": [
        "/home/lauer/miniforge3/envs/convmem/bin/python",
        "/home/lauer/Projects/convmem/mcp_server.py"
      ],
      "environment": {
        "CONVMEM_MCP_PROFILE": "shell"
      },
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "task": "allow",
    "skill": "allow",
    "edit": {
      "*": "deny",
      ".opencode/scratch/*": "allow"
    },
    "bash": {
      "*": "ask",
      "convmem *": "allow",
      "convmem": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git fetch*": "allow",
      "git show*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "python -c *": "allow",
      "python --version*": "allow",
      "pip list*": "allow",
      "pip show*": "allow",
      "pytest *": "allow",
      "ruff check*": "allow",
      "pylint *": "allow",
      "sudo *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "* --no-verify": "deny",
      "chmod 777*": "deny",
      "mkfs*": "deny",
      "dd * of=/dev/*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "convmem record*": "deny",
      "convmem index*": "deny",
      "git push*": "ask",
      "git commit*": "ask",
      "git add*": "ask",
      "npm publish*": "deny",
      "docker push*": "deny"
    },
    "external_directory": {
      "~/Projects/*": "allow",
      "~/.config/crush/*": "allow",
      "~/.local/share/convmem/*": "allow"
    }
  }
}
