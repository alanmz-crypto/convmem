    "canonicalization_rule": "normalization_may_not_erase_a_distinction_required_by_admitted_target_classes",
    "raw_transport_bytes_required": false,
    "raw_transport_substitute": "complete_adapter_defined_envelope"
  },
  "capability_vector": {
    "dimensions": {
      "occurrence_identity": ["NATIVE_UNIQUE", "ISSUER_ATTESTED", "DERIVED", "ABSENT"],
      "source_instance_binding": ["ATTESTED", "DECLARED", "ABSENT"],
      "revision_asof_binding": ["REVISION_PINNED", "ASOF_PINNED", "CURRENT_ONLY", "UNKNOWN"],
      "evidence_completeness": ["COMPLETE", "PARTIAL_KNOWN", "UNKNOWN", "MISSING"],
      "canonical_verification": ["VERIFIED", "UNVERIFIED", "MISMATCH"],
      "temporal_reproducibility": ["REPLAYABLE", "CAPTURE_ATTESTED", "MUTABLE", "UNKNOWN"],
      "attachment_material_span_completeness": ["COMPLETE", "PARTIAL_KNOWN", "UNKNOWN", "MISSING"],
      "preservation_replay_capability": ["SEALED_REPLAYABLE", "SEALED_NONREPLAYABLE", "UNSEALED", "ABSENT"],
      "lineage_assurance": ["IMMUTABLE_ATTESTED", "DECLARED", "UNKNOWN", "ABSENT"]
