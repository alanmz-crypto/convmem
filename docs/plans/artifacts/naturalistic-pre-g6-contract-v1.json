{
  "artifact_type": "naturalistic_pre_g6_contract",
  "contract_version": "naturalistic-pre-g6-contract-v1",
  "arc": "Naturalistic ConvMem product-value evaluation",
  "status": "PROPOSED_NOT_LOCKED",
  "authority": {
