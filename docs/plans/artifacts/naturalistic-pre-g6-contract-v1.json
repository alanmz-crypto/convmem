        "evidence_complete_envelope_and_canonicalization_policy",
        "resolver_semantics_and_version_policy",
        "attachment_and_material_span_policy",
        "snapshot_retention_and_replay_policy",
        "target_eligibility_unitization_and_denominator_policy",
        "missingness_evaluability_integrity_and_invalidity_policy",
        "legacy_and_summary_firewall",
        "scorer_semantics_and_score_range",
        "disposition_precedence",
        "controller_side_c0_c1_evidence_path",
        "role_access_and_blinded_views",
        "replay_and_counterbalance_policy"
      ],
      "must_not_contain": [
        "post_agent_a_source_identity_values",
        "result_dependent_placeholders",
        "implicit_attachment_policy",
        "implicit_target_multiplicity_rule"
      ]
    },
    "evidence_seal": {
      "stage": "P1_POST_AGENT_A",
      "artifact_type": "EvidenceSealManifestV1",
      "required_parent_field": "construct_freeze_digest",
      "binds": [
        "actual_source_occurrence_identity",
        "physical_instance_and_lineage_assertion",
        "revision_or_asof_identity",
        "evidence_complete_record_envelopes",
        "evidence_snapshot_identity",
        "raw_envelope_canonical_and_profile_commitments",
        "attachment_and_reference_completeness",
        "opaque_resolver_inputs_and_outputs"
      ],
      "may_not_change": "any_construct_freeze_field"
    },
    "digest_procedure": {
      "serialization": "RFC8785_JSON_CANONICALIZATION_SCHEME",
      "encoding": "UTF-8",
      "digest": "SHA-256(canonical_bytes)",
      "self_digest": "excluded_from_canonical_bytes",
      "sidecar": "docs/plans/artifacts/naturalistic-pre-g6-contract-v1.json.sha256"
    }
  },
  "amendment_policy": {
    "versioning": "immutable_semantic_version_and_new_digest",
    "before_agent_a": "explicit_amendment_and_outcome_blind_independent_review",
    "after_agent_a": "construct_change_invalidates_dependent_generation",
    "after_registry_seal": "no_construct_or_membership_repair; create_new_generation",
    "unchanged_profile_digest_is_sufficient": false,
    "implementation_change_requires": [
      "new_implementation_identity",
      "explicit_amendment",
      "outcome_blind_equivalence_review",
      "adversarial_differential_evidence",
      "stage_authorization"
    ]
  },
  "identity_model": {
    "occurrence_reference_fields": [
      "source_system_id",
      "tenant_or_realm_id",
      "authority_scope_id",
      "occurrence_namespace_id",
      "physical_source_instance_id",
      "native_id_namespace",
      "native_record_id",
      "source_revision_or_asof_id"
    ],
    "separate_evidence_fields": [
      "logical_lineage_id",
      "evidence_snapshot_id",
      "evidence_complete_envelope_digest",
      "canonical_content_digest",
      "canonicalization_profile_digest"
    ],
    "issuance": "provider_or_importer_issuer_controls_occurrence_namespace",
    "hash_role": "verification_only_not_identity",
    "rules": {
      "clone": "new_physical_instance_without_immutable_lineage",
      "restore": "new_physical_instance; identical content does not collapse identity",
      "import_export": "importer_mints_local_occurrence_namespace",
      "migration": "new occurrence namespace unless immutable issuer lineage proves continuity",
      "preserved_row_ids": "do_not_preserve_source_authority",
      "id_reuse": "delete_and_recreate_is_new_occurrence",
      "edit": "new revision of same occurrence only with provider revision semantics",
      "partial_export": "evidence_snapshot_with_unknown_cross_instance_deduplication"
    },
    "content_commitment": {
      "preimage": "self_excluding_domain_separated_instance_manifest",
      "required": ["issuer_identity", "import_or_creation_event", "instance_nonce"],
      "cannot_assert": "source_truth_or_logical_population_membership"
    }
  },
  "source_evidence_contract": {
    "raw_definition": "adapter_defined_evidence_complete_record_envelope",
    "required_semantics": [
      "evidential_fields",
      "authorship",
      "chronology_and_timezone",
      "reply_or_parent_structure",
      "validity_metadata",
