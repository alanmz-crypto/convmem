{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alanmz-crypto/convmem/docs/plans/artifacts/naturalistic-pre-g6-contract-v3.schema.json",
  "title": "Naturalistic PRE-G6 Contract V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "contract_version",
    "arc",
    "status",
    "supersedes",
    "provenance_roots",
    "authorization",
    "canonicalization",
    "normative_authority",
    "amendment_policy",
    "role_access_policy",
    "stage_graph",
    "source_resolution_contract",
    "identity_model",
    "source_evidence_contract",
    "capability_model",
    "denominator_model",
    "adjudication_view",
    "snapshot_authority",
    "legacy_summary_firewall",
    "implementation_binding",
    "scorer_key_policy",
    "c0_c1_equality",
    "decision_registry",
    "invariants",
    "verification_controls",
    "coordination"
  ],
  "properties": {
    "artifact_type": {"const": "naturalistic_pre_g6_contract"},
    "contract_version": {"const": "naturalistic-pre-g6-contract-v3"},
    "arc": {"const": "Naturalistic ConvMem product-value evaluation"},
    "status": {"enum": ["PROPOSED_NOT_LOCKED", "REVIEWED_NOT_LOCKED", "LOCKED_BY_RYAN"]},
    "supersedes": {"type": "object", "required": ["version", "reviewed_commit", "canonical_digest", "reason"]},
    "provenance_roots": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["id", "url", "title", "state_at_contract_materialization", "relationship", "required_invariant"]}
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_authorized", "g6_authorized", "t0_authorized", "naturalistic_execution_authorized", "product_disposition_authorized"],
      "properties": {
        "implementation_authorized": {"const": false},
        "g6_authorized": {"const": false},
        "t0_authorized": {"const": false},
        "naturalistic_execution_authorized": {"const": false},
        "product_disposition_authorized": {"const": false}
      }
    },
    "canonicalization": {"type": "object", "required": ["serialization", "encoding", "digest", "trailing_bytes", "self_digest", "sidecar", "validator"]},
    "normative_authority": {"type": "object", "required": ["canonical_contract", "schema", "conformance_cases", "changed_field_manifest", "prose_role", "conflict_rule", "derived_views"]},
    "amendment_policy": {"type": "object", "required": ["construct_amendment_requires", "before_agent_a", "after_agent_a", "same_authority_identity_with_changed_estimand", "implementation_amendment_is_additional_to_construct_amendment", "validator", "failure_transition"]},
    "role_access_policy": {"type": "object", "required": ["roles", "adjudication_interface", "unknown_or_unlisted_field"]},
    "stage_graph": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "parent", "parent_artifact", "parent_digest_field", "consumes", "produces", "authority_created", "validator", "failure_transition", "required_fields", "forbidden_fields"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "parent": {"type": ["string", "null"]},
          "parent_artifact": {"type": ["string", "null"]},
          "parent_digest_field": {"type": ["string", "null"]},
          "consumes": {"type": "array", "items": {"type": "string"}},
          "produces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "authority_created": {"type": "string", "minLength": 1},
          "validator": {"type": "string", "minLength": 1},
          "failure_transition": {"type": "string", "minLength": 1},
          "required_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "forbidden_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "source_resolution_contract": {"type": "object", "required": ["provenance_root", "orthogonal_fields", "required_provenance_fields_when_available", "rules", "validator", "failure_transition"]},
    "identity_model": {"type": "object", "required": ["occurrence_reference_fields", "separate_fields", "hash_role", "physical_identity_rules", "semantic_unit_rule", "conformance_examples"]},
    "source_evidence_contract": {"type": "object", "required": ["raw_definition", "required_semantics", "commitments", "canonicalization_rule", "unstable_transport_hash_is_raw_authority", "per_source_class_policy"]},
    "capability_model": {"type": "object", "required": ["dimensions", "per_use_acceptance", "reduction_rule", "derived_human_ceiling"]},
    "denominator_model": {"type": "object", "required": ["fixed_episode_denominator", "orthogonal_target_state", "target_count_bounds", "estimand_propagation", "rules"]},
    "adjudication_view": {"type": "object", "required": ["artifact_type", "built_from", "built_before", "allowed_fields", "forbidden_fields", "view_shape_rule", "join_rule", "validator"]},
    "snapshot_authority": {"type": "object", "required": ["authority_classes", "decision_inputs", "ordered_decision_rules", "snapshot_is_occurrence_authority", "later_source_mutation_is_preservation_failure"]},
    "legacy_summary_firewall": {"type": "object", "required": ["provenance_requirement", "unknown_lineage", "contamination_propagation", "covered_descendants", "stripping_original_content_cleans_descendant", "prospective_summary", "validator"]},
    "implementation_binding": {"type": "object", "required": ["manifest_type", "required_component_ids", "required_identity_fields", "unlisted_behavior_relevant_component", "replacement_requires", "unchanged_contract_or_profile_digest_is_sufficient", "after_agent_a_behavior_change", "validator"]},
    "scorer_key_policy": {"type": "object", "required": ["semantic_freeze", "scorer_author_must_not_inspect", "target_key_instantiator", "mechanical_instantiation_proof", "validator"]},
    "c0_c1_equality": {"type": "object", "required": ["manifest_type", "comparison", "required_equal_paths", "only_permitted_difference", "condition_specific_prompt_insertion", "unknown_or_missing_path", "other_difference", "informative_missingness", "validator"]},
    "decision_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "semantics", "allowed_domain", "units", "allowed_states", "preferred", "owner_authority", "freeze_stage", "evidence_required", "validator", "failure_transition", "accepted_downside", "overturning_evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^D_[A-Z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "semantics": {"type": "string", "minLength": 1},
          "allowed_domain": {"type": "object", "minProperties": 1},
          "units": {"type": "string", "minLength": 1},
          "allowed_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "preferred": {"type": "string", "minLength": 1},
          "owner_authority": {"type": "string", "minLength": 1},
          "freeze_stage": {"const": "P0_T0_CONSTRUCT_FREEZE"},
          "evidence_required": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "validator": {"type": "string", "minLength": 1},
          "failure_transition": {"type": "string", "minLength": 1},
          "accepted_downside": {"type": "string", "minLength": 1},
          "overturning_evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "invariants": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "verification_controls": {"type": "array", "minItems": 18, "uniqueItems": true, "items": {"type": "string"}},
    "coordination": {"type": "object", "required": ["g6_lane", "g6_assumptions_preserved", "g6_conflicts_found", "dependency_chain", "issue_263_implementation_state"]}
  }
}
