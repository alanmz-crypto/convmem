[Unit]
Description=Back up thirteen personal project roots with separate Restic repositories

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/lauer/.local/libexec/restic-personal-projects.py backup --quiesce-known-writers
TimeoutStartSec=12h
UMask=0077

