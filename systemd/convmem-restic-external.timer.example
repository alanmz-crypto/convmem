# User systemd timer — offsite Restic copy every 2 hours starting at 01:00
#
#   cp systemd/convmem-restic-external.{service,timer}.example ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now convmem-restic-external.timer
#   systemctl --user list-timers convmem-restic-external.timer
#
# Persistent=true catches up one missed run after the drive is reconnected
# or the machine wakes. The copy itself skips when the USB drive is unplugged,
# so extra wakeups are cheap. A stale local source exits 25, copies nothing,
# and is visible in the failed state and journal.

[Unit]
Description=convmem offsite Restic copy every 2h

[Timer]
OnCalendar=*-*-* 01/2:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
