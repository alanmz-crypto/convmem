[Unit]
Description=Four daily personal project Restic backups at machine-local times

[Timer]
OnCalendar=*-*-* 00:45:00
OnCalendar=*-*-* 06:45:00
OnCalendar=*-*-* 12:45:00
OnCalendar=*-*-* 18:45:00
Persistent=false
AccuracySec=1min
Unit=restic-personal-projects.service

[Install]
WantedBy=timers.target

# ref: ./restic-personal-projects.service — one bounded capture per trigger
