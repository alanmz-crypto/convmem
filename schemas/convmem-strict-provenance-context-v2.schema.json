{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convmem.strict-provenance-context.v2",
  "title": "convmem.strict-provenance-context.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_semantics",
    "policies",
    "recipes",
    "verified_channels",
    "registered_assertions",
    "grounding_sha256",
    "context_payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "convmem.strict-provenance-context.v2"
    },
    "schema_semantics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "binding_version",
          "semantic_bytes_b64",
          "semantic_sha256"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "minLength": 1
          },
          "binding_version": {
            "type": "string",
            "minLength": 1
          },
          "semantic_bytes_b64": {
            "type": "string",
            "minLength": 1
          },
          "semantic_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_version",
          "semantic_bytes_b64",
          "semantic_sha256",
          "rules"
        ],
        "properties": {
          "policy_version": {
            "type": "string",
            "minLength": 1
          },
          "semantic_bytes_b64": {
            "type": "string",
            "minLength": 1
          },
          "semantic_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "transformer_class",
                "transformer_identity",
                "transformer_version",
                "recipe_id",
                "cap",
                "preservation_contract",
                "artifact_sha256"
              ],
              "properties": {
                "transformer_class": {
                  "type": "string",
                  "minLength": 1
                },
                "transformer_identity": {
                  "type": "string",
                  "minLength": 1
                },
                "transformer_version": {
                  "type": "string",
                  "minLength": 1
                },
                "recipe_id": {
                  "type": "string",
                  "minLength": 1
                },
                "cap": {
                  "type": "string",
                  "minLength": 1
                },
                "preservation_contract": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "artifact_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recipe_id",
          "recipe_bytes_b64",
          "recipe_sha256"
        ],
        "properties": {
          "recipe_id": {
            "type": "string",
            "minLength": 1
          },
          "recipe_bytes_b64": {
            "type": "string",
            "minLength": 1
          },
          "recipe_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "verified_channels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin_class",
          "channel_class",
          "channel_locator",
          "channel_evidence_sha256"
        ],
        "properties": {
          "origin_class": {
            "type": "string",
            "minLength": 1
          },
          "channel_class": {
            "type": "string",
            "minLength": 1
          },
          "channel_locator": {
            "type": "string",
            "minLength": 1
          },
          "channel_evidence_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "registered_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "provenance_commitment",
          "envelope"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "minLength": 1
          },
          "provenance_commitment": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "envelope": {
            "type": "object"
          }
        }
      }
    },
    "grounding_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
