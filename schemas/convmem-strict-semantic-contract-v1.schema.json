{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convmem.strict-semantic-contract.v1",
  "title": "convmem.strict-semantic-contract.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reducer_version",
    "grounding_version",
    "canonicalization_version",
    "identity_version",
    "search_kernel",
    "search_kernel_version",
    "tokenizer_unicode_version",
    "schema_digests",
    "contract_payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "convmem.strict-semantic-contract.v1"
    },
    "reducer_version": {
      "type": "string",
      "minLength": 1
    },
    "grounding_version": {
      "type": "string",
      "minLength": 1
    },
    "canonicalization_version": {
      "type": "string",
      "minLength": 1
    },
    "identity_version": {
      "type": "string",
      "minLength": 1
    },
    "search_kernel": {
      "type": "string",
      "minLength": 1
    },
    "search_kernel_version": {
      "type": "string",
      "minLength": 1
    },
    "tokenizer_unicode_version": {
      "type": "string",
      "minLength": 1
    },
    "schema_digests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "contract_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
