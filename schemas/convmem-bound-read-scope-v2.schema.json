{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convmem.bound-read-scope.v2",
  "title": "convmem.bound-read-scope.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "allowed_project_bindings",
    "domain",
    "site_mode",
    "site",
    "authority_snapshot",
    "serving_projection",
    "max_snapshot_age_seconds"
  ],
  "properties": {
    "schema": {
      "const": "convmem.bound-read-scope.v2"
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "allowed_project_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "site_mode": {
      "enum": [
        "exact",
        "not_applicable"
      ]
    },
    "site": {
      "type": [
        "string",
        "null"
      ]
    },
    "authority_snapshot": {
      "type": "string",
      "minLength": 1
    },
    "serving_projection": {
      "type": "string",
      "minLength": 1
    },
    "max_snapshot_age_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    }
  }
}
