{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convmem.strict-source-cutoff.v1",
  "title": "convmem.strict-source-cutoff.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lineage_id",
    "mode",
    "operations",
    "cutoff_payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "convmem.strict-source-cutoff.v1"
    },
    "lineage_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "mode": {
      "enum": [
        "fixture",
        "production"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "input_sha256",
          "source_prefix_sha256"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "source_prefix_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "cutoff_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
