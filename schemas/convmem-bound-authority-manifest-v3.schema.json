{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convmem.bound-authority-manifest.v3",
  "title": "convmem.bound-authority-manifest.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lineage_id",
    "authority_seq",
    "owner_digest",
    "snapshot_id",
    "parent_snapshot_id",
    "parent_manifest_sha256",
    "scope_sha256",
    "registry_sha256",
    "input_sha256",
    "source_cutoff_sha256",
    "operation_id",
    "authority_records_sha256",
    "record_count",
    "dispositions_sha256",
    "disposition_count",
    "citation_map_sha256",
    "provenance_context_sha256",
    "grounding_sha256",
    "added_assertion_ids",
    "added_disposition_ids",
    "added_provenance_ids",
    "added_grounding_refs",
    "semantic_contract_sha256",
    "reducer_version",
    "canonicalization_version",
    "builder_version",
    "builder_tree_sha256",
    "built_at",
    "as_of",
    "expires_at",
    "manifest_payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "convmem.bound-authority-manifest.v3"
    },
    "lineage_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "authority_seq": {
      "type": "integer"
    },
    "owner_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "registry_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_cutoff_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "authority_records_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_count": {
      "type": "integer"
    },
    "dispositions_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "disposition_count": {
      "type": "integer"
    },
    "citation_map_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance_context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "grounding_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "added_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "added_disposition_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "added_provenance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "added_grounding_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "semantic_contract_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reducer_version": {
      "type": "string",
      "minLength": 1
    },
    "canonicalization_version": {
      "type": "string",
      "minLength": 1
    },
    "builder_version": {
      "type": "string",
      "minLength": 1
    },
    "builder_tree_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "built_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "manifest_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
