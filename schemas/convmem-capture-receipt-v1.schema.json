{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convmem.capture-receipt.v1",
  "title": "convmem.capture-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capture_id",
    "capture_class",
    "capture_issuer_id",
    "source_registration_id",
    "source_event_id",
    "provenance_assertion_id",
    "provenance_commitment",
    "input_bindings_sha256",
    "transformer_artifact_sha256",
    "recipe_sha256",
    "submitted_views_sha256",
    "returned_output_sha256",
    "captured_at",
    "receipt_payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "convmem.capture-receipt.v1"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "capture_class": {
      "enum": [
        "synthetic_fixture",
        "controlled_capture"
      ]
    },
    "capture_issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "source_registration_id": {
      "type": "string",
      "minLength": 1
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance_assertion_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance_commitment": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "input_bindings_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "transformer_artifact_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "submitted_views_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "returned_output_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "receipt_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
