{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convmem.project-binding-registry.v3",
  "title": "convmem.project-binding-registry.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "bindings"
  ],
  "properties": {
    "schema": {
      "const": "convmem.project-binding-registry.v3"
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "public_ref",
          "project",
          "domain_root",
          "site_mode",
          "site",
          "non_expanding_roots",
          "source_registrations",
          "lineage_id",
          "capture_issuers",
          "verification_producers"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "public_ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "project": {
            "type": "string",
            "minLength": 1
          },
          "domain_root": {
            "type": "string",
            "minLength": 1
          },
          "site_mode": {
            "enum": [
              "exact",
              "not_applicable"
            ]
          },
          "site": {
            "type": [
              "string",
              "null"
            ]
          },
          "non_expanding_roots": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_registrations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_class",
                "source_identity",
                "identity_match",
                "authorization_domain",
                "site",
                "event_id_resolver"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_class": {
                  "type": "string",
                  "minLength": 1
                },
                "source_identity": {
                  "type": "string",
                  "minLength": 1
                },
                "identity_match": {
                  "const": "exact"
                },
                "authorization_domain": {
                  "type": "string",
                  "minLength": 1
                },
                "site": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "event_id_resolver": {
                  "const": "fixture_scan_event_v1"
                }
              }
            }
          },
          "lineage_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "capture_issuers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "issuer_id",
                "capture_class",
                "enrollment_sha256",
                "receipt_root",
                "source_registration_ids"
              ],
              "properties": {
                "issuer_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                },
                "capture_class": {
                  "enum": [
                    "synthetic_fixture",
                    "controlled_capture"
                  ]
                },
                "enrollment_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "receipt_root": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^/"
                },
                "source_registration_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "verification_producers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_registration_id",
                "producer",
                "transformer_identity",
                "transformer_version",
                "transformer_artifact_sha256",
                "recipe_sha256",
                "capture_class"
              ],
              "properties": {
                "source_registration_id": {
                  "type": "string",
                  "minLength": 1
                },
                "producer": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,15}$"
                },
                "transformer_identity": {
                  "type": "string",
                  "minLength": 1
                },
                "transformer_version": {
                  "type": "string",
                  "minLength": 1
                },
                "transformer_artifact_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "recipe_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "capture_class": {
                  "enum": [
                    "synthetic_fixture",
                    "controlled_capture"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
