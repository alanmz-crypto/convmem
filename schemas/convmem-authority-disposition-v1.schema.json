{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convmem.authority-disposition.v1",
  "title": "convmem.authority-disposition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "project_binding_id",
    "subject_assertion_id",
    "subject_semantic_sha256",
    "target_assertion_ids",
    "basis_snapshot_id",
    "expected_head_assertion_ids",
    "replaces_disposition_ref",
    "review_actor",
    "review_role",
    "review_outcome",
    "reviewed_at",
    "ratifier_actor",
    "ratifier_role",
    "ratified_at",
    "rationale_sha256"
  ],
  "properties": {
    "schema": {
      "const": "convmem.authority-disposition.v1"
    },
    "action": {
      "enum": [
        "decision_approved",
        "decision_rejected",
        "decision_revoked",
        "evidence_withdrawn",
        "supersession_authorized"
      ]
    },
    "project_binding_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_assertion_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_semantic_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "target_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "basis_snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "expected_head_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "replaces_disposition_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_actor": {
      "type": "string",
      "minLength": 1
    },
    "review_role": {
      "const": "kiro-design-reviewer"
    },
    "review_outcome": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "reviewed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "ratifier_actor": {
      "type": "string",
      "minLength": 1
    },
    "ratifier_role": {
      "const": "ryan-authority-owner"
    },
    "ratified_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "rationale_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
