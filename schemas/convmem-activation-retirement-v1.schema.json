{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "convmem.activation-retirement.v1",
  "title": "convmem.activation-retirement.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slot_id",
    "activation_id",
    "activation_manifest_sha256",
    "pinned_publication_sha256",
    "manager_boot_id",
    "unit_invocation_id",
    "containment_id",
    "terminal_reason",
    "observed_empty_boottime_ns",
    "receipt_payload_sha256"
  ],
  "properties": {
    "schema": {
      "const": "convmem.activation-retirement.v1"
    },
    "slot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "activation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "activation_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pinned_publication_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "manager_boot_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "containment_id": {
      "type": "string",
      "minLength": 1
    },
    "terminal_reason": {
      "type": "string",
      "minLength": 1
    },
    "observed_empty_boottime_ns": {
      "type": "integer"
    },
    "receipt_payload_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
